# General Config
# Copy this file to `.env` and fill in the values.
# Note: do not put spaces around `=`, and quotes are optional.

# ---------------------------------
# Location of Media Share
# These env variables should point to the mount of your SMB/NFS share that hosts your data
# (Linux paths are case-sensitive, so make sure the case matches your mount)

# Path to where your TV Shows should be stored
TV_SHOW_PATH="/mnt/SMB-Share/TV Shows"

# Path to where Sabnzbd will store the downloaded files for Sonarr to pick up.
# Note that Sabnzbd writes a lot of data to this dir, so storing it on a local temp disk is recommended vs a network share
DOWNLOAD_PATH=/mnt/data1/sabnzbd-temp-downloads

# Path to where tdarr should store transcoded files
# Note that Tdarr writes a lot of data to this dir, so storing it on a local temp disk is recommended vs a network share
TRANSCODE_PATH=/mnt/data1/tdarr-transcode

# Path to where Sabnzbd will store temp download files
TEMP_DOWNLOAD_PATH=/mnt/SMB-Share/Usenet/temp

# (Optional) Path to where Sabnzbd should monitor for .nzb files (ex: manually queued downloads)
NZB_WATCH_PATH=/mnt/SMB-Share/Usenet/nzb

# ---------------------------------
# Plex Config (docker-compose-plex.yaml)

# Path to your Plex media library (mounted read-write so Plex can edit it)
PLEX_MEDIA_PATH=/mnt/plex-store

# Path where Plex stores temporary transcode files (a local disk is recommended)
PLEX_TRANSCODE_PATH=/mnt/data1/plex-transcode

# (Optional) Encrypted Plex backups (scripts/plex-backup.sh), see docs/plex-backup.md
#PLEX_BACKUP_DEST=/mnt/plex-main/backups
#PLEX_BACKUP_AGE_KEY=age1...
#PLEX_BACKUP_MOUNT=/mnt/plex-main
#PLEX_BACKUP_KEEP_DAYS=56
#PLEX_BACKUP_INCLUDE_MEDIA=false

# (Optional) User/group IDs Plex runs as. These must be able to read and write PLEX_MEDIA_PATH. Defaults to 1000
#PLEX_UID=1000
#PLEX_GID=1000

# URL that Swag should fetch cert for (will get a wildcard cert)
DOMAIN=123.ca

# ---------------------------------
# CROWDSEC Config

# API Key for Crowdsec Bouncer (generate with: openssl rand -hex 24)
CROWDSEC_API_KEY=123
